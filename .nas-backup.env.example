# NAS backup tool transport configuration.
# Copy to .nas-backup.env and fill in real values. .nas-backup.env is git-ignored.
# Only the keys documented below are accepted. Unknown keys, `export`, command
# substitution, backticks, and `source` syntax are rejected by the loader.

# SSH destination for the Relive NAS, e.g. user@host. No personal tracked default.
RELIVE_NAS_HOST=user@nas.example.com

# Relive install root on the NAS.
RELIVE_NAS_ROOT=/volume1/docker/relive

# Live SQLite database path on the NAS (must be inside the container data volume).
RELIVE_NAS_DB=/volume1/docker/relive/data/backend/relive.db

# Backup output root on the NAS.
RELIVE_NAS_BACKUP_DIR=/volume1/docker/relive/backup

# Retention: number of newest successful backup directories to keep.
# 0 means never delete old backups automatically.
RELIVE_BACKUP_KEEP=0

# Optional per-invocation label, e.g. `RELIVE_BACKUP_LABEL=pre-task14 make backup-nas`.
# Defaults to `manual`. Allowed: [A-Za-z0-9][A-Za-z0-9._-]{0,49}
RELIVE_BACKUP_LABEL=manual
